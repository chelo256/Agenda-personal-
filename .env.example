# Configuración de Evidence Manager
# Copia este archivo a .env y completa con tus valores

# Configuración de Base de Datos
DB_PATH=evidence.db

# Configuración Google Drive (opcional)
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials.json
GOOGLE_DRIVE_TOKEN_PATH=token.pickle

# Configuración Dropbox (opcional)
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token_here

# Configuración AWS S3 (opcional)
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Configuración Google Cloud Storage (opcional)
GCS_BUCKET_NAME=your-bucket-name
GCS_CREDENTIALS_PATH=service-account.json

# Configuración Web
FLASK_SECRET_KEY=your_secret_key_here
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Configuración de Imágenes
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1080